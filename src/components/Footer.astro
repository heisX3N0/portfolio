---
import { getLastUpdated } from '../lib/site';

interface Props {
  site: { email: string; linkedin: string; github: string };
}

const { site } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <ul class="site-footer__links">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.linkedin}>LinkedIn</a></li>
      <li><a href={site.github}>GitHub</a></li>
    </ul>
    <ul class="site-footer__meta small muted">
      <li>Last updated {getLastUpdated()}</li>
      <li><a href="/about/#how-this-site-was-built">Built from a spec with Claude Code</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-6);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }
  .site-footer__links,
  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Mobile: one item per line, so no separator is left dangling at a line end. */
  .site-footer__meta {
    flex-direction: column;
  }
  .site-footer a {
    display: inline-block;
    padding-block: var(--space-1);
  }
  @media (min-width: 48rem) {
    .site-footer__meta {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-2);
    }
    .site-footer__meta li + li::before {
      content: '·';
      margin-right: var(--space-2);
    }
  }
</style>
