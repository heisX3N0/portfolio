---
// Proof strip (SPEC 4.1 item 2): figure first, description underneath. Desktop: a 5-column panel that
// overlaps the hero band; mobile: a 5-row list with the figure on the left. Items come from content.
interface Props {
  items: { figure: string; text: string }[];
}

const { items } = Astro.props;
---

<ul class="proof" data-proof-strip aria-label="Proof points">
  {
    items.map((item) => (
      <li class="proof__item">
        <span class="proof__figure">{item.figure}</span>
        <span class="proof__text">{item.text}</span>
      </li>
    ))
  }
</ul>

<style>
  .proof {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 3px solid var(--accent);
  }
  .proof__item {
    display: grid;
    grid-template-columns: 7.75rem minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .proof__figure {
    font-family: var(--font-serif);
    font-size: 1.4375rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .proof__text {
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--muted);
  }

  @media (min-width: 64rem) {
    .proof {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      background: var(--surface);
      border: 1px solid var(--border);
      border-top: 3px solid var(--accent);
    }
    .proof__item {
      display: block;
      padding: 1.375rem var(--space-5);
      border-bottom: 0;
      border-right: 1px solid var(--rule);
    }
    .proof__item:last-child {
      border-right: 0;
    }
    .proof__figure {
      display: block;
      font-size: 2.125rem;
      line-height: 1.05;
    }
    .proof__text {
      display: block;
      margin-top: var(--space-2);
      line-height: 1.45;
    }
  }
</style>
