---
// Contact section on every page (SPEC 4.1 item 6, SPEC 3 v3.1): the header's "Contact" jumps here.
// Role pages pass their contact line; other pages show the links without a sentence.
import Icon from './Icon.astro';

interface Props {
  email: string;
  linkedin: string;
  cvFile: string;
  contactLine?: string;
}

const { email, linkedin, cvFile, contactLine } = Astro.props;
---

<section id="contact" class="contact" aria-labelledby="contact-heading">
  <div class="container contact__inner">
    <div>
      <h2 id="contact-heading">Contact</h2>
      {contactLine && <p class="contact__line">{contactLine}</p>}
    </div>
    <div class="contact__actions">
      <ul class="contact__links">
        <li><a href={`mailto:${email}`}><Icon name="mail" />{email}</a></li>
        <li><a href={linkedin}><Icon name="linkedin" />LinkedIn</a></li>
      </ul>
      <a class="button button--primary" href={cvFile}><Icon name="download" />Download CV</a>
    </div>
  </div>
</section>

<style>
  .contact {
    margin-top: var(--space-8);
    padding-block: var(--space-7);
    background: var(--surface);
    border-top: 1px solid var(--border);
    scroll-margin-top: var(--space-4);
  }
  .contact__inner {
    display: grid;
    gap: var(--space-5);
  }
  .contact h2 {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 3px solid var(--gold);
    display: inline-block;
  }
  .contact__line {
    margin: var(--space-3) 0 0;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    max-width: 32ch;
  }
  .contact__actions {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 48rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .contact__actions {
      justify-items: end;
    }
  }
</style>
