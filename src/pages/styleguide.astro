---
// Style guide (SPEC 10 phase 1, rebuilt for P1.5 direction B). Not in the sitemap. Sample text is approved copy
// from SPEC.md only. The hero sample comes first so its first screen can be checked at 1366x768 and 390x844.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Card from '../components/Card.astro';
import Figure from '../components/Figure.astro';
import ArtefactTable from '../components/ArtefactTable.astro';
import Thumbnail from '../components/Thumbnail.astro';
import Icon from '../components/Icon.astro';
import HowIWork from '../components/HowIWork.astro';
import { getEntry } from 'astro:content';
import { getSite } from '../lib/site';
import { palette, pairs, contrast } from '../lib/palette';

const site = await getSite();

// The BA role page's own content file, so the style guide always shows the live copy.
const entry = await getEntry('roles', 'business-analyst');
if (!entry?.data.published) throw new Error('styleguide needs the published business-analyst role');
const ba = { ...entry.data, proof: entry.data.proofStrip };
const steps = ba.howIWork;
// Artefact samples, from approved copy: the How I work stages (labels only) and the Aimery injection scores (SPEC 5.3).
const flowSample = {
  kind: 'flow' as const,
  id: 'fig-how-i-work',
  caption: 'How I work: the five stages of the BA lifecycle.',
  label: 'Simplified' as const,
  steps: steps.map((s) => ({ label: s.step, highlight: false })),
};
const tableSample = {
  kind: 'table' as const,
  id: 'sg-injection',
  caption: 'Prompt injection test: fit scores for a job posting (Aimery).',
  columns: ['Posting', 'Fit score'],
  rows: [
    ['Clean posting', '76 to 79'],
    ['Injected, before the fix', '83 to 84'],
    ['Injected, after the fix', '79 to 80'],
  ],
};
---

<BaseLayout
  title={`Style guide | ${site.name}`}
  description="Hero, proof strip, type, colour, card, figure, table and contact styles used across this site."
  contactLine={ba.contactLine}
>
  <Hero
    name={site.name}
    title={ba.title}
    positioning={ba.positioning}
    supporting={ba.supporting}
    workHref="#sg-cards"
    cvFile={site.defaultCv}
    email={site.email}
    linkedin={site.linkedin}
    contactLine={ba.contactLine}
    location={site.location}
    proof={ba.proof}
    headshot={site.headshot}
  />

  <div class="container">
    <section class="sg-intro" aria-labelledby="sg-title">
      <h2 id="sg-title">Style guide</h2>
      <p class="lead">
        The building blocks for every page. Above is the BA role page's first screen, built from these parts. Sample text comes
        from the approved copy in SPEC.md. Use the theme button in the header to see each part in dark mode, and narrow the
        window to see the mobile layout.
      </p>
    </section>

    <section aria-labelledby="sg-type">
      <h2 id="sg-type">Type</h2>
      <p class="muted small">
        Headings: Source Serif 4. Body: Inter. Both self-hosted, Latin subset, <code>font-display: swap</code>. The hero name
        uses the display size (about 62px desktop, 36px mobile); the positioning line uses the regular serif at weight 400.
      </p>
      <div class="prose">
        <p class="sg-display">Boluwatife Olapade</p>
        <p class="sg-positioning">Business Analyst who builds with AI.</p>
        <h3>From CBN circular to live limits in 4 weeks</h3>
        <h4>At a glance</h4>
        <p class="lead">I work where business, delivery and product meet.</p>
        <p>
          I turn regulatory deadlines, tangled processes and AI ideas into requirements that banks and product teams can build,
          then test that what ships is what was needed. CBAP-certified, with 4 years across banking, payments and AI products.
        </p>
        <p class="small muted">Small text: Lagos, Nigeria</p>
        <p><a href={site.substack}>A text link to Substack</a></p>
        <ul>
          <li>Treat regulatory text as requirements input, with clause-level traceability.</li>
          <li>Agree acceptance criteria with compliance before build starts.</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="sg-colour">
      <h2 id="sg-colour">Colour</h2>
      <div class="prose">
        <p>
          Deep navy matches the CV and carries the header and hero band. Ochre gold is the one warm accent: the title line, the
          primary action, rules, highlights and tags. It is never used for body text or large fills.
        </p>
        <p>
          In dark mode the band stays the same navy, with a 1px lighter edge so it keeps its shape against the dark page.
        </p>
      </div>
      {
        (['light', 'dark'] as const).map((mode) => (
          <div class="swatch-set">
            <h3>{mode === 'light' ? 'Light' : 'Dark'}</h3>
            <ul class="swatches">
              {Object.entries(palette[mode]).map(([name, hex]) => (
                <li>
                  <span class="swatch" style={`background:${hex}`} />
                  <code>--{name}</code> <span class="muted">{hex}</span>
                </li>
              ))}
            </ul>
            <div class="table-wrap">
              <table>
                <caption>Contrast, {mode} theme</caption>
                <thead>
                  <tr>
                    <th scope="col">Use</th>
                    <th scope="col">Pair</th>
                    <th scope="col">Ratio</th>
                    <th scope="col">Needs</th>
                  </tr>
                </thead>
                <tbody>
                  {pairs.map((p) => {
                    const colours: Record<string, string> = palette[mode];
                    const ratio = contrast(colours[p.fg], colours[p.bg]);
                    return (
                      <tr>
                        <th scope="row">{p.use}</th>
                        <td>
                          <code>--{p.fg}</code> on <code>--{p.bg}</code>
                        </td>
                        <td>{ratio.toFixed(1)}:1</td>
                        <td>{p.min > 1 ? `${p.min}:1` : 'No minimum'}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="sg-actions">
      <h2 id="sg-actions">Buttons and tags</h2>
      <p class="muted small">On the navy band: gold for the one primary action, an outline for the rest. On the page: navy.</p>
      <div class="sg-band">
        <div class="actions">
          <a class="button button--gold" href="#sg-cards">View my work</a>
          <a class="button button--on-hero" href={site.defaultCv}><Icon name="download" />Download CV</a>
        </div>
      </div>
      <div class="actions sg-gap">
        <a class="button button--primary" href={site.defaultCv}><Icon name="download" />Download CV</a>
        <a class="button button--secondary" href="#sg-cards">View my work</a>
      </div>
      <ul class="tags sg-gap" aria-label="Tags">
        <li class="tag">Banking</li>
        <li class="tag">AI product</li>
        <li class="tag">Requirements</li>
        <li class="tag">Process</li>
        <li class="tag">Data</li>
        <li class="tag">AI governance</li>
      </ul>
    </section>

    <section aria-labelledby="sg-proof">
      <h2 id="sg-proof">Proof strip</h2>
      <p class="muted small">
        Figure first, description underneath. In the hero it overlaps the band on desktop; on mobile it is a 5-row list with
        the figure on the left. On its own it looks like this:
      </p>
      <ProofStrip items={ba.proof} />
      <p class="small muted sg-gap">
        The naira sign comes from a naira-only font file per family (about 1.2 KB each), loaded only on pages that use it.
      </p>
    </section>

    <section aria-labelledby="sg-how">
      <h2 id="sg-how">How I work</h2>
      <p class="muted small">
        An HTML list, not a diagram, so it never scrolls sideways: a row on wide screens, numbered steps down the page on
        narrow ones. On the role page each step can end with one "Example:" link to a published case study.
      </p>
      <HowIWork steps={steps.map(({ step, line }) => ({ step, line }))} />
    </section>

    <section aria-labelledby="sg-headshot">
      <h2 id="sg-headshot">Headshot slot</h2>
      <div class="prose">
        <p>
          Off in v1 (<code>headshot.show: false</code> in <code>site.yaml</code>): the hero above is the off state, complete
          with no gap. With it on, a round image with a gold ring sits beside the name on desktop (160px) and above it on mobile
          (96px), with alt text "{site.name}".
        </p>
      </div>
      <div class="sg-band sg-headshot" aria-hidden="true">
        <span class="sg-headshot__circle"></span>
        <span class="sg-headshot__name">{site.name}</span>
      </div>
    </section>

    <section aria-labelledby="sg-cards">
      <h2 id="sg-cards">Cards</h2>
      <p class="muted small">A sketch of the case study's first artefact, then the figure, title, one-line outcome and tags.</p>
      <ul class="card-grid">
        <li>
          <Card
            title="From CBN circular to live limits in 4 weeks"
            href="#sg-cards"
            summary="Live in 4 weeks, making the Bank the first to comply."
            tags={['Banking', 'Requirements']}
            figure="4 weeks"
          >
            <Thumbnail slot="thumbnail" kind="table" />
          </Card>
        </li>
        <li>
          <Card
            title="Specifying an AI assistant, then trying to break it"
            href="#sg-cards"
            summary="Injected postings scored back in the clean range after the fix."
            tags={['AI product', 'AI governance']}
            figure="79 to 80"
          >
            <Thumbnail slot="thumbnail" kind="flow" />
          </Card>
        </li>
        <li>
          <Card
            title="Turning a prototype's failures into a product's requirements"
            href="#sg-cards"
            summary="300 test emails sent with 0 errors; $0 running cost."
            tags={['AI product', 'Requirements']}
            figure="100+ backlog items"
          >
            <Thumbnail slot="thumbnail" kind="table" />
          </Card>
        </li>
      </ul>
    </section>

    <section aria-labelledby="sg-callout">
      <h2 id="sg-callout">At a glance box</h2>
      <div class="callout">
        <h3 class="h4">At a glance</h3>
        <ul>
          <li><strong>Problem:</strong> a new CBN circular set new transaction limits for agent banking.</li>
          <li><strong>My role:</strong> Business Analyst &amp; Project Manager, Financial Inclusion.</li>
          <li><strong>What I produced:</strong> functional requirements from the circular.</li>
          <li><strong>Outcome:</strong> live in 4 weeks, the first bank to comply.</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="sg-figure">
      <h2 id="sg-figure">Figure</h2>
      <p class="muted small">Drawn at build time, wide and narrow; the figure shows the one that fits, so it never scrolls sideways.</p>
      <Figure artefact={flowSample} />
    </section>

    <section aria-labelledby="sg-table">
      <h2 id="sg-table">Table</h2>
      <div class="prose">
        <ArtefactTable artefact={tableSample} />
      </div>
    </section>

    <section aria-labelledby="sg-contact">
      <h2 id="sg-contact">Contact section</h2>
      <p class="prose">
        Every page ends with the contact section below, and the header's "Contact" jumps to it. Role pages pass their own
        sentence (this page uses the BA one); other pages show the links without a sentence.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .sg-intro {
    margin-top: var(--space-8);
  }
  .sg-display {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--display);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.015em;
  }
  .sg-positioning {
    font-family: var(--font-serif);
    font-size: var(--positioning);
    line-height: 1.2;
  }
  .swatch-set + .swatch-set {
    margin-top: var(--space-6);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
  }
  .swatch {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .sg-band {
    padding: var(--space-5);
    background: var(--hero-bg);
    color: var(--on-hero);
    border: 1px solid var(--hero-edge);
    border-radius: var(--radius);
  }
  .sg-band :focus-visible {
    outline-color: var(--on-hero-gold);
  }
  .sg-gap {
    margin-top: var(--space-5);
  }
  .sg-headshot {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 32rem;
  }
  .sg-headshot__circle {
    flex: none;
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    border: 2px solid var(--on-hero-gold);
    background: var(--hero-rule);
  }
  .sg-headshot__name {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
  }
  .h4 {
    font-size: var(--step-1);
  }
</style>
