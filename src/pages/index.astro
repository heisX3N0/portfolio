---
// Root page (SPEC 2.3 and 4.0): a short introduction, one card per published role page, three selected case
// studies and contact. It does not repeat a role page's proof strip.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import WorkCard from '../components/WorkCard.astro';
import { getSite } from '../lib/site';
import { getPublishedRoles, getWork, pick } from '../lib/content';
import { personJsonLd } from '../lib/seo';

const site = await getSite();
const roles = await getPublishedRoles();
const selected = pick(await getWork(), site.selectedWork, 'site.yaml selectedWork');
const jsonLd = await personJsonLd(Astro.site!);
---

<BaseLayout title={site.name} description={`${site.rootLine} ${site.rootIntro}`} jsonLd={jsonLd}>
  <Hero
    name={site.name}
    positioning={site.rootLine}
    supporting={site.rootIntro}
    workHref="#selected-work"
    cvFile={site.defaultCv}
    email={site.email}
    linkedin={site.linkedin}
    location={site.location}
    headshot={site.headshot}
  />

  <div class="container">
    <section class="page-section" aria-labelledby="roles-heading">
      <h2 id="roles-heading">Roles</h2>
      <ul class="card-grid">
        {
          roles.map((r) => (
            <li>
              <Card title={r.title} href={`/${r.slug}/`} summary={r.positioning} />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="selected-work" class="page-section" aria-labelledby="selected-work-heading">
      <h2 id="selected-work-heading">Selected work</h2>
      <ul class="card-grid">
        {
          selected.map((w) => (
            <li>
              <WorkCard work={w} />
            </li>
          ))
        }
      </ul>
      <p><a href="/work/">All work</a></p>
    </section>
  </div>
</BaseLayout>
