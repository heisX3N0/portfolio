# Cloudflare Pages headers. Security headers and the CSP arrive in P4 (SPEC 9.5).

# CV PDFs open in the browser and stay out of search results (SPEC 4.5).
/cv/*
  Content-Disposition: inline
  X-Robots-Tag: noindex

# Fonts are cached for a year: never change a font file's content without changing its name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
